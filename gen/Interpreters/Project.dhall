-- Project interpreter: turns a Project into the generated Go files.
-- Emits go.mod, db.go and a single queries.sql.go (flat package).
let Deps = ../Deps/package.dhall

let Algebra = ../Algebras/Interpreter.dhall

let Sdk = Deps.Sdk

let Prelude = Deps.Prelude

let QueryGen = ./Query.dhall

let CustomTypeGen = ./CustomType.dhall

let Input = Sdk.Project.Project

let Output = List Sdk.File.Type

let dbGo =
      \(pkg : Text) ->
        ''
        // Code generated by golang.gen. DO NOT EDIT.

        package ${pkg}

        import (
        	"context"

        	"github.com/jackc/pgx/v5"
        	"github.com/jackc/pgx/v5/pgconn"
        )

        // DBTX is the interface that both pgx.Conn and pgx.Tx implement.
        type DBTX interface {
        	Query(ctx context.Context, sql string, args ...any) (pgx.Rows, error)
        	QueryRow(ctx context.Context, sql string, args ...any) pgx.Row
        	Exec(ctx context.Context, sql string, args ...any) (pgconn.CommandTag, error)
        }

        type Queries struct {
        	db DBTX
        }

        func New(db DBTX) *Queries {
        	return &Queries{db: db}
        }

        // WithTx returns a new Queries instance using the provided transaction.
        func (q *Queries) WithTx(tx pgx.Tx) *Queries {
        	return &Queries{db: tx}
        }
        ''

let goMod =
      \(moduleName : Text) ->
        ''
        module ${moduleName}

        go 1.26

        require github.com/jackc/pgx/v5 v5.9.2
        ''

let modelsGo =
      \(pkg : Text) ->
      \(customTypes : List CustomTypeGen.Output) ->
        let needsTime =
              Prelude.List.any
                CustomTypeGen.Output
                (\(t : CustomTypeGen.Output) -> t.needsTime)
                customTypes

        let timeImport = if needsTime then [ "\t\"time\"" ] else [] : List Text

        let importBlock =
              Prelude.Text.concatSep
                "\n"
                (   [ "\t\"context\"" ]
                  # timeImport
                  # [ "", "\t\"github.com/jackc/pgx/v5\"" ]
                )

        let bodies =
              Prelude.Text.concatMapSep
                "\n"
                CustomTypeGen.Output
                (\(t : CustomTypeGen.Output) -> t.body)
                customTypes

        let typeNames =
              Prelude.Text.concatMapSep
                "\n"
                CustomTypeGen.Output
                ( \(t : CustomTypeGen.Output) ->
                    ''
                    ${"\t\t"}"${t.pgFullName}",
                    ${"\t\t"}"${t.pgArrayFullName}",''
                )
                customTypes

        in  ''
            // Code generated by golang.gen. DO NOT EDIT.

            package ${pkg}

            import (
            ${importBlock}
            )

            ${bodies}
            // RegisterTypes loads the custom PostgreSQL types used by this package
            // (enums, composites, domains and their array forms) into the
            // connection's type map so pgx can encode parameters and scan columns
            // of these types. Call it once per connection, e.g. from AfterConnect.
            func RegisterTypes(ctx context.Context, conn *pgx.Conn) error {
            	pending := []string{
            ${typeNames}
            	}
            	// Types may reference each other (composites containing other
            	// custom types), so retry until a pass makes no progress.
            	for len(pending) > 0 {
            		remaining := make([]string, 0, len(pending))
            		var lastErr error
            		for _, name := range pending {
            			t, err := conn.LoadType(ctx, name)
            			if err != nil {
            				remaining = append(remaining, name)
            				lastErr = err
            				continue
            			}
            			conn.TypeMap().RegisterType(t)
            		}
            		if len(remaining) == len(pending) {
            			return lastErr
            		}
            		pending = remaining
            	}
            	return nil
            }
            ''

let run =
      \(config : Algebra.Config) ->
      \(input : Input) ->
        let pkg = config.packageName

        let compiledQueries
            : Sdk.Compiled.Type (List QueryGen.Output)
            = Sdk.Compiled.traverseList
                Sdk.Project.Query
                QueryGen.Output
                (QueryGen.run config)
                input.queries

        let compiledCustomTypes
            : Sdk.Compiled.Type (List CustomTypeGen.Output)
            = Sdk.Compiled.traverseList
                Sdk.Project.CustomType
                CustomTypeGen.Output
                (CustomTypeGen.run config)
                input.customTypes

        let assemble =
              \(customTypes : List CustomTypeGen.Output) ->
              \(queries : List QueryGen.Output) ->
                let any =
                      \(f : QueryGen.Output -> Bool) ->
                        Prelude.List.any QueryGen.Output f queries

                let needsPgx = any (\(q : QueryGen.Output) -> q.needsPgx)

                let needsErrors = any (\(q : QueryGen.Output) -> q.needsErrors)

                let needsTime = any (\(q : QueryGen.Output) -> q.needsTime)

                let needsTextFormats =
                      any (\(q : QueryGen.Output) -> q.needsTextFormats)

                let textFormatsVar =
                      if    needsTextFormats
                      then  ''

                            // forceTextFormats requests the text format for types whose pgx
                            // binary codecs cannot scan into string.
                            var forceTextFormats = pgx.QueryResultFormatsByOID{
                            	650:  pgx.TextFormatCode, // cidr
                            	651:  pgx.TextFormatCode, // cidr[]
                            	869:  pgx.TextFormatCode, // inet
                            	1041: pgx.TextFormatCode, // inet[]
                            	1186: pgx.TextFormatCode, // interval
                            	1187: pgx.TextFormatCode, // interval[]
                            }
                            ''
                      else  ""

                let stdImports =
                        [ "\t\"context\"" ]
                      # ( if    needsErrors
                          then  [ "\t\"errors\"" ]
                          else  [] : List Text
                        )
                      # (if needsTime then [ "\t\"time\"" ] else [] : List Text)

                let pgxImports =
                      if    needsPgx
                      then  [ "\t\"github.com/jackc/pgx/v5\"" ]
                      else  [] : List Text

                let importBlock =
                      Prelude.Text.concatSep
                        "\n"
                        (   stdImports
                          # (if needsPgx then [ "" ] else [] : List Text)
                          # pgxImports
                        )

                let bodies =
                      Prelude.Text.concatMapSep
                        "\n"
                        QueryGen.Output
                        (\(q : QueryGen.Output) -> q.body)
                        queries

                let queriesFile =
                      ''
                      // Code generated by golang.gen. DO NOT EDIT.

                      package ${pkg}

                      import (
                      ${importBlock}
                      )
                      ${textFormatsVar}
                      ${bodies}''

                let moduleName =
                          Deps.CodegenKit.Name.toTextInSnake input.space
                      ++  "/"
                      ++  pkg

                let modelsFile =
                      if    Prelude.List.null CustomTypeGen.Output customTypes
                      then  [] : List Sdk.File.Type
                      else  [ { path = "models.go"
                              , content = modelsGo pkg customTypes
                              }
                            ]

                in    [ { path = "go.mod", content = goMod moduleName }
                      , { path = "db.go", content = dbGo pkg }
                      ]
                    # modelsFile
                    # [ { path = "queries.sql.go", content = queriesFile } ]

        in  Sdk.Compiled.map2
              (List CustomTypeGen.Output)
              (List QueryGen.Output)
              (List Sdk.File.Type)
              assemble
              compiledCustomTypes
              compiledQueries

in  Algebra.module Input Output run
